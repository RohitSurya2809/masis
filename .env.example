# MASIS Website Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase ──────────────────────────────────────────────────────────────
# Your Supabase project URL (from Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — SERVER-SIDE ONLY, never expose to the client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Get your key at https://resend.com
# Required to send notification emails for new enquiries and demo requests.
RESEND_API_KEY=re_your_api_key_here

# The email address that receives notification emails
NOTIFY_EMAIL=hello@masis.in

# ── Application ────────────────────────────────────────────────────────────
# The canonical URL of the deployed site (used for SEO)
NEXT_PUBLIC_SITE_URL=https://masis.in
